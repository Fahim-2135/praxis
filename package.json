{
  "name": "praxis",
  "version": "0.2.2",
  "private": true,
  "description": "Learns your Claude Code habits from the history you already have: a Claude Code mod that profiles how you work, guards irreversible commands, and proposes inspectable rules with human approval.",
  "type": "module",
  "bin": {
    "praxis": "bin/praxis.mjs",
    "praxis-history": "bin/praxis-history.mjs"
  },
  "scripts": {
    "test": "node scripts/run-tests.mjs",
    "test:mod": "claude plugin test",
    "validate": "claude plugin validate .",
    "history": "node bin/praxis-history.mjs",
    "demo": "node scripts/demo.mjs",
    "bench": "node scripts/bench.mjs",
    "inspect": "node scripts/inspect-log.mjs",
    "detect": "node scripts/detect.mjs",
    "status": "node bin/praxis.mjs status",
    "review": "node bin/praxis.mjs review",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.4.1",
    "globals": "^17.6.0",
    "prettier": "^3.8.3"
  }
}
